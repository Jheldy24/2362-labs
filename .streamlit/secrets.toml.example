# Copy to .streamlit/secrets.toml and replace every placeholder. Never commit it.
[connections.apex]
dialect="postgresql"
driver="psycopg"
host="YOUR_DATABASE_HOST"
port=5432
database="apex_facilities"
username="YOUR_ASSIGNED_DATABASE_USER"
password="YOUR_ASSIGNED_DATABASE_PASSWORD"
[connections.apex.query]
sslmode="verify-full"
sslrootcert="C:/path/to/trusted-root-ca.pem"
connect_timeout="10"
[connections.apex.create_engine_kwargs]
pool_pre_ping=true
pool_recycle=1800
pool_size=1
max_overflow=0
pool_timeout=10
[apex]
workspace_schema="ws_aida2362_example01"
